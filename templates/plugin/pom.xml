<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>__GROUP_ID__</groupId><artifactId>__PLUGIN_ID__</artifactId><version>__PLUGIN_VERSION__</version>
  <name>__PLUGIN_NAME__</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <astra.version>__FRAMEWORK_VERSION__</astra.version><astra.api.version>__API_VERSION__</astra.api.version>
    <astra.buildRoot>${project.basedir}/target</astra.buildRoot>
  </properties>
  <dependencies><dependency>
    <groupId>top.hetaoawa</groupId><artifactId>astra-api</artifactId><version>${astra.api.version}</version><scope>provided</scope>
  </dependency></dependencies>
  <build><directory>${astra.buildRoot}</directory><resources>
    <resource><directory>src/main/resources</directory></resource>
    <resource><directory>.astra-tools</directory><targetPath>META-INF</targetPath><includes><include>LICENSE</include><include>NOTICE</include></includes></resource>
  </resources><plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
      <configuration><parameters>true</parameters><proc>none</proc></configuration>
    </plugin>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
      <configuration><archive><manifestEntries>
        <Plugin-Id>__PLUGIN_ID__</Plugin-Id><Plugin-Version>${project.version}</Plugin-Version>
        <Plugin-Class>top.hetaoawa.astra.runtime.AstraPluginManager$BridgePlugin</Plugin-Class>
        <Plugin-Requires>__FRAMEWORK_VERSION__</Plugin-Requires>
        <Astra-Entrypoint>__PACKAGE__.MyPlugin</Astra-Entrypoint><Astra-Api-Version>1</Astra-Api-Version>
      </manifestEntries></archive></configuration>
    </plugin>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
      <executions><execution><phase>package</phase><goals><goal>shade</goal></goals></execution></executions>
      <configuration>
        <createDependencyReducedPom>false</createDependencyReducedPom>
        <artifactSet><excludes>
          <exclude>top.hetaoawa:astra-api</exclude><exclude>top.hetaoawa:astra-core</exclude>
          <exclude>top.hetaoawa:astra-runtime</exclude><exclude>top.hetaoawa:astra-qq</exclude><exclude>top.hetaoawa:astra-storage</exclude>
          <exclude>org.pf4j:*</exclude><exclude>org.slf4j:*</exclude>
          <exclude>ch.qos.logback:*</exclude><exclude>org.apache.logging.log4j:*</exclude>
        </excludes></artifactSet>
        <filters><filter><artifact>*:*</artifact><excludes>
          <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
        </excludes></filter></filters>
        <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/></transformers>
      </configuration>
    </plugin>
  </plugins></build>
</project>
